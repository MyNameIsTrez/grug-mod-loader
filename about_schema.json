{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "version",
        "game_version",
        "authors",
        "repository",
        "licenses"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string"
        },
        "version": {
            "type": "string"
        },
        "game_version": {
            "type": "string"
        },
        "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string"
            }
        },
        "repository": {
            "$ref": "#/definitions/repository"
        },
        "licenses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/license"
            }
        },
        "derived_from": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "repository",
                    "licenses"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "repository": {
                        "$ref": "#/definitions/repository"
                    },
                    "licenses": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "$ref": "#/definitions/license"
                        }
                    },
                    "credits": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uri"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "repository": {
            "type": "object",
            "required": [
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        },
        "license": {
            "type": "object",
            "required": [
                "name",
                "url"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "note": {
                    "type": "string"
                }
            }
        }
    }
}
